import pygame
height = 400
width = 600
screen = pygame.display.set_mode((width, height))
dred = (155, 0, 0)
red = (255, 0, 0)
blue = (0, 0, 255)
lblue = (150, 150, 255)
black = (0, 0, 0)
grey = (100, 100, 110)
lgrey = (190, 190, 190)
green = (0, 155, 0)
dgreen = (0, 100, 0)
yellow = (255, 255, 0)
white = (255, 255, 255)
tan = (211, 198, 132)
def carriage(x, y, color):
  pygame.draw.line(screen, lgrey, (x, y), (x, y + 20), 5)
  pygame.draw.rect(screen, color, (x - 20, y + 20, 40, 20))
def supports():
  y = 210
  for i in range(5):
    x = (i * 45) + 405
    pygame.draw.line(screen, red, (x, y), (x, 350), 5)
    y -= 10
  for j in range(2):
    w = (j * 50) + 250
    pygame.draw.line(screen, red, (405, w), (600, w), 5)
running = True
while running:
  screen.fill(lblue)
  pygame.draw.rect(screen, grey, (0, 350, width, 50))
  pygame.draw.line(screen, lgrey, (50, 350), (125, 240), 10)
  pygame.draw.line(screen, lgrey, (210, 350), (140, 240), 10)
  pygame.draw.circle(screen, lgrey, (134, 240), 13)
  pygame.draw.circle(screen, grey, (134, 240), 78, 10)
  carriage(170, 180, red)
  carriage(206, 225, blue)
  carriage(62, 225, blue)
  carriage(87.5, 295, red)
  carriage(170, 295, yellow)
  carriage(90, 180, yellow)
  
  supports()
  pygame.draw.line(screen, dred, (600, 250), (400, 210), 15)
  pygame.draw.line(screen, dred, (600, 160), (400, 210), 15)

  pygame.draw.rect(screen, green, (250, 250, 120, 100))
  pygame.draw.rect(screen, dgreen, (275, 275, 50, 50))
  pygame.draw.rect(screen, dgreen, (255, 220, 110, 25))
  pygame.draw.rect(screen, white, (258, 222.75, 105, 20))
  
  pygame.draw.rect(screen, blue, (290, 310, 15, 15))
  pygame.draw.circle(screen, blue, (297.5, 310), 7.5)
  pygame.draw.circle(screen, tan, (297.5, 300), 9)
  pygame.draw.rect(screen, blue, (287.5, 285, 20, 10))
  pygame.display.update()
  for event in pygame.event.get():
    if event.type == pygame.QUIT:
      running = False
pygame.quit()
