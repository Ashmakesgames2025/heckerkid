import random
import pygame
pygame.init()

width = 400
height = 500
screen = pygame.display.set_mode((width, height))
clock = pygame.time.Clock()

black = (0, 0, 0)
red = (255, 0, 0)
blue = (0, 0, 255)
green = (0, 175, 0)
dargreen = (0, 75, 0)
brown = (131, 105, 83)
tan = (251, 238, 172)
pink = (255, 192, 203)

bonked = False
gameover = False
timer = 30
counter = 0
counter2 = 0
score = 0
miss = 0
hit_timer = 3

def text(x, y, size, color, info):
  font = pygame.font.SysFont("none",size)
  text = font.render(info, False, color)
  screen.blit(text,(x,y))

def mole(x, y):
  pygame.draw.circle(screen, brown, (x, y), 30)
  pygame.draw.circle(screen, tan, (x, y), 25)
  pygame.draw.ellipse(screen, pink, (x - 7, y, 14, 7))
  pygame.draw.ellipse(screen, black, (x - 7, y, 14, 7), 1)
  
  if not bonked:
    pygame.draw.circle(screen, black, (x + 7, y - 7), 5)
    pygame.draw.circle(screen, black, (x - 7, y - 7), 5)
  
  if bonked:
    pygame.draw.line(screen, black, (x + 12, y - 12), (x + 2, y - 2), 2)
    pygame.draw.line(screen, black, (x + 12, y - 2), (x + 2, y - 12), 2)
    pygame.draw.line(screen, black, (x - 12, y - 12), (x - 2, y - 2), 2)
    pygame.draw.line(screen, black, (x - 12, y - 2), (x - 2, y - 12), 2)

holex, holey = width//2, height//2 + 100

holes = [(holex, holey, 1), (holex + 100, holey, 2), (holex - 100, holey, 3), 
         (holex, holey + 100, 4), (holex, holey - 100, 5), (holex + 100, holey + 100, 6), 
         (holex - 100, holey + 100, 8), (holex + 100, holey - 100, 7), (holex - 100, holey - 100, 9)
        ]

def text(x, y, size, color, info):
  font = pygame.font.SysFont("none",size)
  text = font.render(info, False, color)
  screen.blit(text,(x,y))

running = True

hole_no = random.randint(1,9)

while running:
  screen.fill(green)
  pygame.draw.rect(screen, dargreen, (0, 0, width, 175))
  
  mouse_x, mouse_y = pygame.mouse.get_pos()
  if not gameover:
    
    for hole in holes:
      pygame.draw.circle(screen, (0, 0, 0), (hole[0], hole[1]), 45)

      if hole[2] == hole_no:
        mole_x, mole_y = hole[0], hole[1]
        mole(mole_x, mole_y)
        molebox = pygame.Rect(mole_x - 30, mole_y - 30, 60, 60)

        if counter == 60:
          if timer == 0:
            gameover = True
          counter = 0
          timer -= 1
          counter2 += 1

          if counter2 == hit_timer:
            hole_no = random.randint(1,9)
            counter2 = 0
            bonked = False

    counter += 1

    pygame.draw.line(screen, (131, 105, 83), (mouse_x, mouse_y - 10), (mouse_x, mouse_y + 20), 10)
    pygame.draw.rect(screen, (150, 150, 140), (mouse_x - 20, mouse_y - 30, 40, 20))
    hammerbox = pygame.Rect(mouse_x - 20, mouse_y - 30, 40, 20)

    text(10, 10, 30, black, f'Timer : {timer}')
  else:
    text(10, 10, 30, black, 'GAME OVER :D')
  text(10, 50, 30, red, f'Misses : {miss}')
  text(10, 90, 30, blue, f'Score : {score}')
  
  for event in pygame.event.get():
    if event.type == pygame.QUIT:
      running = False
    if event.type == pygame.MOUSEBUTTONDOWN and event.button == 1:

      if molebox.colliderect(hammerbox):

        if bonked == False:
          bonked = True
          score += 1
          counter = 0
          if score%10 == 0:
            hit_timer -= 0.5
          counter2 = hit_timer - 1

      else:
        miss += 1
  
  pygame.display.update()
  clock.tick(60)

pygame.quit()
