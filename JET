import pygame
import random
pygame.init()
width = 600
height = 400
screen = pygame.display.set_mode((width, height))
pygame.display.set_caption("JET")
clock = pygame.time.Clock()
bg = (5, 5, 20)
white = (205, 205, 220)
flamecolor = (255, 150, 0)
bodycolor1 = (245, 54, 0)
wingcolor1 = (200, 30, 0)
bodycolor2 = (0, 108, 255)
wingcolor2 = (30, 90, 200)
bulletcolor = (255, 255, 0)
def funcstar():
  for star in stars:
    pygame.draw.circle(screen, white, (star['x'], star['y']), star['size'])
    star['y'] += star['speed']
    if star['y'] > height:
      star['y'] = 0
      star['x'] = random.randint(2, width - 2)
      star['size'] = random.uniform(1.00, 4.00)
      star['speed'] = random.uniform(1.5, 2.5)
stars = []
for _ in range(150):
  star = {
    'x' : random.randint(2, width - 2),
    'y' : random.randint(2, height - 2), 
    'size' : random.uniform(1.00, 4.00),
    'speed' : random.uniform(1.5, 2.5)
  }
  stars.append(star)
class Bullet:
  def __init__(self, x, y):
    self.width = 2
    self.height = 5
    self.x = x
    self.y = y
    self.speed = 2.5
  def draw(self):
    if self.y > -1:
      pygame.draw.rect(screen, bulletcolor, (self.x, self.y, self.width, self.height))
  def ascend(self):
    self.y -= self.speed
class Player:
  def __init__(self, bodycolor, wingcolor):
    self.width = 48
    self.height = 56
    self.x = (width - self.width) // 2
    self.y = height - self.height - 20
    self.cx = self.x - (self.width // 2)
    self.speed = 6
    self.bodycolor = bodycolor
    self.wingcolor = wingcolor
    self.bullets = []
    self.cooldown = 20
  def up(self):
    self.y = max(0, self.y - self.speed)
  def down(self):
    self.y = min(height, self.y + self.speed)
  def left(self):
    self.x = max(0, self.x - self.speed)
    self.cx = self.x - (self.width // 2)
  def right(self):
    self.x = min(width, self.x + self.speed)
    self.cx = self.x - (self.width // 2)
  def shoot(self):
    b = Bullet(self.cx, self.y)
    self.bullets.append(b)
    self.cooldown = 20
  def update(self):
    if self.cooldown > 0:
      self.cooldown -= 1
    for b in self.bullets:
      b.ascend()
    self.bullets = [b for b in self.bullets if b.y > -5]
  def draw(self):
    #flame
    flame_h = random.randint(11, 20)
    pygame.draw.polygon(screen, flamecolor, [(self.cx + 6, self.y + 15), (self.cx - 6, self.y + 15), (self.cx, self.y + flame_h + 15)])
    #body
    pygame.draw.polygon(screen, self.bodycolor, [(self.cx - 9, self.y), 
                                            (self.cx, self.y - 7), 
                                            (self.cx + 9, self.y), 
                                            (self.cx + 9, self.y + 20), 
                                            (self.cx - 9, self.y + 20)
                                           ])
    #wings
    pygame.draw.polygon(screen, self.wingcolor, [(self.cx + 9, self.y), (self.cx + 6, self.y + 10), (self.cx + 22, self.y + 17)])
    pygame.draw.polygon(screen, self.wingcolor, [(self.cx - 9, self.y), (self.cx - 6, self.y + 10), (self.cx - 22, self.y + 17)])
    #window
    pygame.draw.ellipse(screen, white, (self.cx - 3, self.y - 2, 6, 8))
    #bullet(s)
    for b in self.bullets:
      b.draw()
player = Player(bodycolor1, wingcolor1)
running = True
while running:
  screen.fill(bg)
  funcstar()
  player.draw()
  player.update()
  for event in pygame.event.get():
    if event.type == pygame.QUIT:
      running = False
  keys = pygame.key.get_pressed()
  if keys[pygame.K_w]:
    player.up()
  elif keys[pygame.K_s]:
    player.down()
  if keys[pygame.K_a]:
    player.left()
  if keys[pygame.K_d]:
    player.right()
  if keys[pygame.K_SPACE]:
    player.shoot()
  pygame.display.update()
  clock.tick(60)
pygame.quit()
